# Copy to .env (never commit .env) and adjust. Every value is optional.

# --- Published site ---------------------------------------------------------
# Host port for the web app, and the origin users type into the browser.
ZS_HTTP_PORT=8080
ZS_PUBLIC_ORIGIN=http://localhost:8080
# Comma-separated host names the backend accepts (no scheme or port).
ZS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Security ---------------------------------------------------------------
# Leave empty to have the container generate one and keep it on its volume.
DJANGO_SECRET_KEY=
# true when the site is served over HTTPS (cookies become HTTPS-only).
DJANGO_SECURE_COOKIES=false
# Sign-in, registration and reset attempts per client.
AUTH_THROTTLE_RATE=10/min

# --- Demo data --------------------------------------------------------------
# true creates the fictional demo organizations and accounts on start-up.
ZS_SEED_DEMO=false
# Required when ZS_SEED_DEMO=true. Choose your own; it must pass Django's
# password rules (10+ characters, not common, not all digits).
ZS_DEMO_PASSWORD=

# --- Email ------------------------------------------------------------------
# Default prints verification/reset emails to the backend log.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real delivery use django.core.mail.backends.smtp.EmailBackend and set:
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# --- Federated sign-in (shown as "not yet available" until configured) -------
AUTH_GOOGLE_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_APPLE_CLIENT_ID=
AUTH_SSO_METADATA_URL=
AUTH_PASSKEYS_ENABLED=false

# --- Footer links (build-time; unset links render as plain text) ------------
VITE_LINK_PRIVACY=
VITE_LINK_TERMS=
VITE_LINK_SECURITY=
VITE_LINK_ACCESSIBILITY=
VITE_LINK_HELP=

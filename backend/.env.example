# Copy to .env (never commit .env) and adjust. POSTGRES_PASSWORD is required;
# every other value is optional.

# --- Database (PostgreSQL 16) -------------------------------------------------
# Required. Password of the database account, set when the database volume is
# first created. Use a long random value, for example the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=zoiko
POSTGRES_USER=zoiko
# Host port of the database with docker-compose.dev.yml (bound to 127.0.0.1).
ZS_DB_PORT=5433
# Where processes run on the host (manage.py, runserver, tests) find the
# database; they read this file. Inside Docker the stack sets these itself.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433

# --- Local development ---------------------------------------------------------
# Debug mode for processes run on the host (manage.py, runserver, tests). Django
# keeps it off unless this says true; never enable it on a server. The Docker
# stack always runs with debug off, whatever this says.
DJANGO_DEBUG=true

# --- Published site ---------------------------------------------------------
# Host port for the web app, and the origin users type into the browser.
ZS_HTTP_PORT=8080
ZS_PUBLIC_ORIGIN=http://localhost:8080
# Comma-separated host names the backend accepts (no scheme or port).
ZS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Security ---------------------------------------------------------------
# Leave empty to have the container generate one and keep it on its volume.
DJANGO_SECRET_KEY=
# true when the site is served over HTTPS (cookies become HTTPS-only).
DJANGO_SECURE_COOKIES=false
# Sign-in, registration and reset attempts per client.
AUTH_THROTTLE_RATE=10/min
# Days a "keep me signed in" session lasts (1-90); otherwise sessions end when
# the browser closes.
SESSION_REMEMBER_DAYS=14

# --- Organizations and invitations --------------------------------------------
# Days an emailed invitation link stays valid (1-30), and invitation preview /
# accept attempts per client.
INVITATION_TTL_DAYS=7
INVITATION_THROTTLE_RATE=30/min

# --- API conventions -----------------------------------------------------------
# Rows per page on list endpoints, and the largest page a client may request.
API_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100
# Hours a create's stored result is replayed for a retried Idempotency-Key.
IDEMPOTENCY_TTL_HOURS=24

# --- Event backbone (outbox worker) ----------------------------------------------
# How often the idle worker looks for due deliveries (ms); deliveries per loop;
# attempts before a delivery is dead (replay with `manage.py outbox replay`);
# retry backoff start and cap (seconds).
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_SECONDS=2
OUTBOX_RETRY_MAX_SECONDS=600
# Days fully delivered events are kept before housekeeping removes them.
OUTBOX_RETENTION_DAYS=30

# --- Housekeeping ------------------------------------------------------------------
# Hours between the worker's clean-ups of expired sessions, idempotency records and
# old delivered events (0 = off; run `manage.py maintenance` yourself).
MAINTENANCE_INTERVAL_HOURS=6

# --- Django admin (Zoiko staff tooling, not the customer product) ----------------
# Off unless enabled (on by default when DJANGO_DEBUG=true); staff accounts only.
# Choose an unguessable path outside /api/ if you enable it anywhere shared.
# DJANGO_ADMIN_ENABLED=true
DJANGO_ADMIN_PATH=admin/

# --- Demo data --------------------------------------------------------------
# true creates the fictional demo organizations and accounts on start-up.
ZS_SEED_DEMO=false
# Required when ZS_SEED_DEMO=true. Choose your own; it must pass Django's
# password rules (10+ characters, not common, not all digits).
ZS_DEMO_PASSWORD=

# --- Email ------------------------------------------------------------------
# Default prints verification/reset emails to the backend log.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real delivery use django.core.mail.backends.smtp.EmailBackend and set:
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# --- Federated sign-in (shown as "not yet available" until configured) -------
AUTH_GOOGLE_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_APPLE_CLIENT_ID=
AUTH_SSO_METADATA_URL=
AUTH_PASSKEYS_ENABLED=false

# --- Footer links (build-time; unset links render as plain text) ------------
VITE_LINK_PRIVACY=
VITE_LINK_TERMS=
VITE_LINK_SECURITY=
VITE_LINK_ACCESSIBILITY=
VITE_LINK_HELP=
